		if(a == 1) {
			return 0;
		} else if (a == 2) {
			return 1;
		} else {
			return a;
		}
		return 3;
	}

	if(a == 1) {
		return 0;	
	} else if (a == 2){
		return 1;
	} else {
		return 2;
	}

	return a;
}

