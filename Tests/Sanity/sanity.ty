int teste(int z) {
	int g = z + 7;
	return g;
}


int compute_benchmark_raw(int* arrX, int* arrY, int* arrOut, int size) {
    for (int i = 0; i < 15; i = i + 1) {
        int x = arrX[i];
        int y = *arrX;//arrY[i];
        
        int val = 0.1;
        
        // Compute-heavy loop relying solely on primitive math operations.
        // This creates a dense dependency chain per element that forces 
        // heavy ALU utilization without needing transcendental functions.

		
        for (int j = 0; j < 40; j = j + 1) {
            int old_x = x;
            x = (x * x) - (y * y) + val;
            y = (2.0 * old_x * y) + val;
            
            // Artificial arithmetic density
            val = x * 0.15 + y * 0.25;
        }
        
        //arrOut[i] = x + y;
    }

    return 0;
}


