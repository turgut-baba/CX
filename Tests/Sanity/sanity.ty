int teste(int z) {
	int g = z + 7;
	return g;
}

void compute_benchmark_raw(float* arrX, float* arrY, float* arrOut, int size) {
    for (int i = 0; i < size; i++) {
        float x = arrX[i];
        float y = arrY[i];
        
        float val = 0.1;
        
        // Compute-heavy loop relying solely on primitive math operations.
        // This creates a dense dependency chain per element that forces 
        // heavy ALU utilization without needing transcendental functions.
        for (int j = 0; j < 40; j++) {
            float old_x = x;
            x = (x * x) - (y * y) + val;
            y = (2.0 * old_x * y) + val;
            
            // Artificial arithmetic density
            val = x * 0.15 + y * 0.25;
        }
        
        arrOut[i] = x + y;
    }
}

